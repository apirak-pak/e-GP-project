# Copy this file to .env, then replace the placeholder with your own DGA API Key.
# Keep .env on your computer. Do not commit or share it.
DGA_API_KEY=PASTE_YOUR_KEY_HERE

# Leave sqlite until the transfer succeeds; then change to postgres.
DB_BACKEND=sqlite
# Copy these values from Supabase Dashboard > Connect > Session pooler > View parameters.
SUPABASE_DB_HOST=PASTE_POOLER_HOST_HERE
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=PASTE_POOLER_USER_HERE
SUPABASE_DB_PASSWORD=PASTE_DATABASE_PASSWORD_HERE
